rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Platform Owner check
    function isPlatformOwner() {
      return request.auth != null && 
             get(/databases/$(database)/documents/super_admin_setting/settings).data.type == 'platformowner';
    }

    // Salon Owner check - owner can only access their own salon
    function isSalonOwner(salonId) {
      return request.auth != null && 
             request.auth.uid == salonId;
    }

    // Stylist check - stylist can only access their own data
    function isStylist(stylistId) {
      return request.auth != null && 
             request.auth.uid == stylistId;
    }

    // Platform Owner can access everything
    match /{document=**} {
      allow read, write: if isPlatformOwner();
    }

    // Salon owners can access their own salon data
    match /salons/{salonId}/{document=**} {
      allow read, write: if isSalonOwner(salonId) || isPlatformOwner();
    }

    // Stylists can access their own subcollections
    match /salons/{salonId}/stylists/{stylistId}/{document=**} {
      allow read, write: if isStylist(stylistId) || isSalonOwner(salonId) || isPlatformOwner();
    }

    // Salon managers collection - only platform owner
    match /salon_managers/{managerId} {
      allow read, write: if isPlatformOwner();
    }

    // Super admin settings - only platform owner
    match /super_admin_setting/settings {
      allow read, write: if isPlatformOwner();
    }

    // Platform settings - only platform owner
    match /settings/{document=**} {
      allow read, write: if isPlatformOwner();
    }
  }
}
