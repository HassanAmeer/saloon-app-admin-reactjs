# ==============================================================================
# Salon Profit Bar - PHP SMTP Configuration
# Place this file in php-smtp/.env OR use the root .env
# ==============================================================================

# SMTP Provider Settings
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM_EMAIL=welcome@salonprofitbar.com
SMTP_FROM_NAME=Salon Profit Bar

# For Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_FROM_NAME=Salon Profit Bar

# For Hostinger Webmail:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@yourdomain.com
# SMTP_PASS=your_email_password
# SMTP_FROM_EMAIL=info@yourdomain.com
