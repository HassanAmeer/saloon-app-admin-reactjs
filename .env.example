# ==============================================================================
# SMTP Email Server Configuration (PHP Backend / Hostinger cPanel / Bun)
# ==============================================================================
# For Resend SMTP:
# - SMTP_HOST=smtp.resend.com
# - SMTP_PORT=465
# - SMTP_SECURE=true
# - SMTP_USER=resend
# - SMTP_PASS=re_your_api_key
# - SMTP_FROM_EMAIL=welcome@yourdomain.com
# - SMTP_FROM_NAME=Salon Profit Bar
#
# For Hostinger Webmail:
# - SMTP_HOST=smtp.hostinger.com
# - SMTP_PORT=465
# - SMTP_SECURE=true
# - SMTP_USER=info@yourdomain.com
# - SMTP_PASS=your_email_password
#
# For Gmail:
# - SMTP_HOST=smtp.gmail.com
# - SMTP_PORT=587 (or 465)
# - SMTP_SECURE=false (true if using port 465)
# - SMTP_USER=your_email@gmail.com
# - SMTP_PASS=your_16_digit_app_password
# ==============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=welcome@salonprofitbar.com
SMTP_FROM_NAME=Salon Profit Bar

# Backend Server Port (For Local PHP or Bun Server)
PORT=5005

# React Frontend Email API URL
# - Local Dev: http://localhost:5005
# - Hostinger Production: https://yourdomain.com/php-smtp
VITE_EMAIL_API_URL=http://localhost:5005

